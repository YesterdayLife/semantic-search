FROM node:24-bookworm-slim AS frontend
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
ENV VITE_DICTIONARY_DEMO=1
RUN npm run build

FROM python:3.12-slim-bookworm
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN pip install --no-cache-dir fastapi==0.136.3 uvicorn==0.35.0 httpx==0.28.1
COPY app/ app/
COPY render_data/ render_data/
COPY --from=frontend /web/dist frontend/dist/
USER 10001
CMD ["sh", "-c", "exec uvicorn app.render_demo:create_demo --factory --host 0.0.0.0 --port \"${PORT:-10000}\""]
